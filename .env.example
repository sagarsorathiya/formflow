# Database
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/formflow

# Redis
REDIS_URL=redis://redis:6379

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=changeme-generate-a-real-secret
NEXTAUTH_URL=https://forms.example.com

# LDAP / Active Directory
LDAP_URL=ldaps://dc01.example.com:636
LDAP_BASE_DN=DC=example,DC=com
LDAP_BIND_DN=CN=svc-formflow,OU=Service Accounts,DC=example,DC=com
LDAP_BIND_PASSWORD=changeme
LDAP_ALLOW_INSECURE=false

# Email (internal SMTP relay, no auth)
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_FROM="FormFlow Portal <formflow@example.com>"

# File uploads
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10

# Windows Integrated SSO (optional). Both must be set to enable; blank = off.
# Configured by scripts/enable-sso-iis.ps1 on the server - do not hand-edit the secret.
# SSO_DOMAIN is the NetBIOS name (the "EXAMPLE" in EXAMPLE\user), not the DNS name.
SSO_DOMAIN=
SSO_SHARED_SECRET=

# Development only — set true to bypass real LDAP (mock users)
DEV_MOCK_LDAP=false
